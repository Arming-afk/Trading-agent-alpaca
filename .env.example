# ── Alpaca (paper) ────────────────────────────────────────────────────────────
# A BRAND-NEW paper account created for this hackathon, funded to $100,000.
# The official CLI reads these directly; env vars default to paper trading.
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...

# Master safety switch. 0 = the agent decides and logs but submits nothing.
# Every order path checks this. Keep 0 until you have watched a dry run.
TRADING_ENABLED=0

# ── Universe ─────────────────────────────────────────────────────────────────
# Liquid, penny-quoted optionable names. Wide markets destroy spread P&L faster
# than any bad forecast, so liquidity is a hard filter, not a preference.
UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,GOOGL,META

# ── Risk gates (all in percent; set any to 0 to disable that gate) ───────────
RISK_MAX_DRAWDOWN_PCT=10      # halt new positions this far below the high-water mark
RISK_MAX_PORTFOLIO_RISK_PCT=25 # sum of max-loss across open spreads, as % of equity
RISK_MAX_TRADE_RISK_PCT=2     # max loss of any single new spread, as % of equity
RISK_MAX_NEW_TRADES_PER_DAY=3

# ── Contract selection guardrails ────────────────────────────────────────────
MIN_DTE=7                     # avoid gamma-risk expiry week
MAX_DTE=45
MAX_SPREAD_PCT=10             # reject a leg whose bid/ask spread exceeds this % of mid
MIN_OPEN_INTEREST=100

# ── LLM (optional narrative layer) ───────────────────────────────────────────
FIREWORKS_API_KEY=
